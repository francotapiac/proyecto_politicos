2018'),\n        size: '15.3 MB',\n        progress: {\n          percent: 33,\n          colorClass: 'warning'\n        }\n      }, {\n        id: 3,\n        picture: require(\"../../assets/tables/3.jpg\"),\n        // eslint-disable-line global-require\n        description: 'Down the road',\n        label: {\n          colorClass: 'danger',\n          text: 'INFO!'\n        },\n        info: {\n          type: 'JPEG',\n          dimensions: '200x150'\n        },\n        date: new Date('September 14, 2018'),\n        size: '49.0 KB',\n        progress: {\n          percent: 38,\n          colorClass: 'inverse'\n        }\n      }, {\n        id: 4,\n        picture: require(\"../../assets/tables/4.jpg\"),\n        // eslint-disable-line global-require\n        description: 'The Edge',\n        info: {\n          type: 'PNG',\n          dimensions: '210x160'\n        },\n        date: new Date('September 15, 2018'),\n        size: '69.1 KB',\n        progress: {\n          percent: 17,\n          colorClass: 'danger'\n        }\n      }, {\n        id: 5,\n        picture: require(\"../../assets/tables/5.jpg\"),\n        // eslint-disable-line global-require\n        description: 'Fortress',\n        info: {\n          type: 'JPEG',\n          dimensions: '1452x1320'\n        },\n        date: new Date('October 1, 2018'),\n        size: '2.3 MB',\n        progress: {\n          percent: 41,\n          colorClass: 'primary'\n        }\n      }],\n      checkboxes1: [false, false, false, false],\n      checkboxes2: [false, false, false, false, false, false],\n      checkboxes3: [false, false, false, false, false, false]\n    };\n  },\n  methods: {\n    parseDate: function parseDate(date) {\n      var dateSet = date.toDateString().split(' ');\n      return \"\".concat(date.toLocaleString('en-us', {\n        month: 'long'\n      }), \" \").concat(dateSet[2], \", \").concat(dateSet[3]);\n    },\n    checkAll: function checkAll(ev, checkbox) {\n      var checkboxArr = new Array(this[checkbox].length).fill(ev.target.checked);\n      Vue.set(this, checkbox, checkboxArr);\n    },\n    changeCheck: function changeCheck(ev, checkbox, id) {\n      this[checkbox][id] = ev.target.checked;\n\n      if (!ev.target.checked) {\n        this[checkbox][0] = false;\n      }\n    },\n    getRandomData: function getRandomData() {\n      var result = [];\n\n      for (var i = 0; i <= 8; i += 1) {\n        result.push(Math.floor(Math.random() * 20) + 1);\n      }\n\n      return [{\n        data: result\n      }];\n    },\n    getRandomColor: function getRandomColor() {\n      var colors = ['#547fff', '#9964e3', '#f55d5d', '#ffc247', '#3abf94'];\n      return {\n        colors: [colors[Math.floor(Math.random() * colors.length)]]\n      };\n    }\n  }\n};",{"version":3,"sources":["Tables.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAibA,OAAA,GAAA,MAAA,KAAA;AACA,OAAA,MAAA,MAAA,4BAAA;AACA,OAAA,UAAA;AAEA,eAAA;AACA,EAAA,IAAA,EAAA,QADA;AAEA,EAAA,UAAA,EAAA;AAAA,IAAA,MAAA,EAAA,MAAA;AAAA,IAAA,UAAA,EAAA;AAAA,GAFA;AAGA,EAAA,IAHA,kBAGA;AACA,WAAA;AACA,MAAA,WAAA,EAAA,CACA;AACA,QAAA,EAAA,EAAA,CADA;AAEA,QAAA,OAAA,EAAA,OAAA,6BAFA;AAEA;AACA,QAAA,WAAA,EAAA,WAHA;AAIA,QAAA,IAAA,EAAA;AACA,UAAA,IAAA,EAAA,MADA;AAEA,UAAA,UAAA,EAAA;AAFA,SAJA;AAQA,QAAA,IAAA,EAAA,IAAA,IAAA,CAAA,oBAAA,CARA;AASA,QAAA,IAAA,EAAA,SATA;AAUA,QAAA,QAAA,EAAA;AACA,UAAA,OAAA,EAAA,EADA;AAEA,UAAA,UAAA,EAAA;AAFA;AAVA,OADA,EAgBA;AACA,QAAA,EAAA,EAAA,CADA;AAEA,QAAA,OAAA,EAAA,OAAA,6BAFA;AAEA;AACA,QAAA,WAAA,EAAA,SAHA;AAIA,QAAA,IAAA,EAAA;AACA,UAAA,IAAA,EAAA,KADA;AAEA,UAAA,UAAA,EAAA;AAFA,SAJA;AAQA,QAAA,